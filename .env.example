# MUI X License key — required for DataGrid Pro/Premium components
# Get your key from https://mui.com/x/introduction/licensing/
VITE_MUI_X_LICENSE_KEY=your_mui_x_license_key_here

# Google Maps API key — used by the Body Map pages
# Get your key from https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Anthropic API key — used by AI summary features (Body Map response views)
# Get your key from https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
